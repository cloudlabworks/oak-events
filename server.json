{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.cloudlabworks/oak-events",
  "title": "oak-events",
  "description": "Privacy-first events from Luxonis OAK cameras for AI agents. Text only, never pictures.",
  "repository": {
    "url": "https://github.com/cloudlabworks/oak-events",
    "source": "github"
  },
  "version": "0.1.2",
  "packages": [
    {
      "registryType": "pypi",
      "identifier": "oak-events",
      "version": "0.1.2",
      "runtimeHint": "uvx",
      "runtimeArguments": [
        { "type": "named", "name": "--with", "value": "mcp" }
      ],
      "packageArguments": [
        { "type": "positional", "value": "mcp" },
        {
          "type": "named",
          "name": "--events-dir",
          "description": "Directory of JSONL event files written by 'oak-events run --out-dir'",
          "isRequired": true,
          "format": "string"
        }
      ],
      "transport": { "type": "stdio" }
    }
  ]
}
